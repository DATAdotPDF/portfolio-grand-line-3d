# Godot 4+ specific ignores
.godot/
/android/
*.tmp

# Builds e backups locais
/Builds/
/_backup/

# Binários pesados (GLBs originais de 24-110 MB, texturas 4k, áudio, vídeos).
# Ficam fora do Git sem LFS; os arquivos .import continuam versionados.
/Assets/**/*.glb
/Assets/**/*.jpg
/Assets/**/*.jpeg
/Assets/**/*.png
/Assets/**/*.mp3
/Assets/**/*.wav
/Assets/**/*.FBX
/Assets/water-wakes/
/Assets/godot-water-shader-main/
/Assets/godot-4-stylized-sky-main/
/References/
/Documentation/Previews/*.png

# Projetos de referência extraídos na raiz (têm project.godot próprio; o Godot os ignora)
/water-wakes/
/godot-4-stylized-sky-main/
/godot-mcp-main/
/godot-water-shader-main/


# Saída do Web/build.ps1 (regenerável)
/Web/public/*
!/Web/public/404.html
/Web/.wrangler/
/.wrangler/


# Versões otimizadas e efeitos sonoros entram no Git (o projeto roda com eles)
!/Assets/Optimized/
!/Assets/Optimized/**
!/Assets/Sound/SFX/
!/Assets/Sound/SFX/**
/Assets/Sound/SFX/OCEAN AND SEAGULLS SFX.mp3


# Gravações brutas do Freesound (até 330 MB cada) ficam fora: o jogo usa os cortes em SFX/Cuts e
# SFX/Generated (créditos em Config/sfx_credits.json). Os SFX curtos já versionados continuam.
/Assets/Sound/SFX/**/*.wav
/Assets/Sound/SFX/**/*.flac
/Assets/Sound/SFX/**/*.mp3
/Assets/Sound/SFX/**/*.m4a
!/Assets/Sound/SFX/Cuts/**
!/Assets/Sound/SFX/Generated/**

# Modelos pesados (criaturas com rig, navio fantasma: 16-75 MB por GLB, texturas 4K) ficam fora do
# Git; o site usa as variantes leves geradas no build (Tools/make_web_variants.py).
/Assets/Optimized/Creatures/*.glb
/Assets/Optimized/Creatures/*.png
/Assets/Optimized/Creatures/*.jpg
/Assets/Optimized/ghost_ship*.glb
/Assets/Optimized/ghost_ship*.png
/Assets/Optimized/ghost_ship*.jpg
/Assets/Optimized/World/_log*.txt

# Cenas de trabalho do Blender (fontes locais, pesadas)
*.blend
*.blend1
/Web/public-test/
