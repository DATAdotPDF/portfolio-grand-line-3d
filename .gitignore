# Godot 4+ specific ignores
.godot/
/android/
*.tmp

# Builds e backups locais
/Builds/
/_backup/

# Binários pesados (GLBs originais de 24-110 MB, texturas 4k, áudio, vídeos).
# Ficam fora do Git sem LFS; os arquivos .import continuam versionados.
/Assets/**/*.glb
/Assets/**/*.jpg
/Assets/**/*.jpeg
/Assets/**/*.png
/Assets/**/*.mp3
/Assets/**/*.wav
/Assets/**/*.FBX
/Assets/water-wakes/
/Assets/godot-water-shader-main/
/Assets/godot-4-stylized-sky-main/
/References/
/Documentation/Previews/*.png

# Projetos de referência extraídos na raiz (têm project.godot próprio; o Godot os ignora)
/water-wakes/
/godot-4-stylized-sky-main/
/godot-mcp-main/
/godot-water-shader-main/


# Saída do Web/build.ps1 (regenerável)
/Web/public/world/
/Web/public/fonts/
/Web/public/classico/
/Web/public/portfolio_content.json
/Web/public/world_config.json
/Web/.wrangler/
/.wrangler/

