[gd_resource type="Resource" script_class="WorldLayout" load_steps=8 format=3]

[ext_resource type="Script" path="res://Scripts/World/WorldLayout.gd" id="1_layout"]
[ext_resource type="Script" path="res://Scripts/World/IslandAnchor.gd" id="2_anchor"]

[sub_resource type="Resource" id="Anchor_sobre"]
script = ExtResource("2_anchor")
section = "Sobre"
lat_deg = 90.0
lon_deg = 0.0
submersion = 1.2

[sub_resource type="Resource" id="Anchor_experiencia"]
script = ExtResource("2_anchor")
section = "Experiência"
lat_deg = 0.0
lon_deg = 0.0
submersion = 3.0

[sub_resource type="Resource" id="Anchor_formacao"]
script = ExtResource("2_anchor")
section = "Formação"
lat_deg = 0.0
lon_deg = 120.0
submersion = 2.3

[sub_resource type="Resource" id="Anchor_projetos"]
script = ExtResource("2_anchor")
section = "Projetos"
lat_deg = 0.0
lon_deg = 240.0
submersion = 1.0

[sub_resource type="Resource" id="Anchor_contato"]
script = ExtResource("2_anchor")
section = "Contato"
lat_deg = -90.0
lon_deg = 0.0
submersion = 3.6

[resource]
script = ExtResource("1_layout")
planet_radius = 800.0
islands = Array[ExtResource("2_anchor")]([SubResource("Anchor_sobre"), SubResource("Anchor_experiencia"), SubResource("Anchor_formacao"), SubResource("Anchor_projetos"), SubResource("Anchor_contato")])
